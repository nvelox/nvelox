FROM --platform=$TARGETPLATFORM alpine:3.24
# mailcap: /etc/mime.types for static Content-Type by extension (see Dockerfile)
RUN apk add --no-cache ca-certificates tzdata mailcap
RUN addgroup -S nvelox && adduser -S nvelox -G nvelox
COPY nvelox /usr/local/bin/nvelox
COPY nvelox.example.yaml /etc/nvelox/nvelox.conf
COPY LICENSE-BINARY NOTICE THIRD_PARTY_NOTICES.md /usr/share/licenses/nvelox/
# The configuration is root's and read-only to the process: nvelox writes
# its logs and nothing else, and a process that was taken over cannot
# rewrite what it is started with.
RUN mkdir -p /etc/nvelox/config.d /var/log/nvelox \
    && chmod -R u=rwX,go=rX /etc/nvelox \
    && chown -R nvelox:nvelox /var/log/nvelox
USER nvelox
ENTRYPOINT ["/usr/local/bin/nvelox"]
CMD ["-config", "/etc/nvelox/nvelox.conf"]
